{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "target": "es6",
    "lib": ["es2015"],
    "sourceMap": true,
    "outDir": "./build",
    "rootDir": "./src",
    "types": ["jest", "node"],

    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,

    "strict": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "build"]
}
